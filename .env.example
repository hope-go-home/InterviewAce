# ============ LLM（阿里云百炼 DashScope，OpenAI 兼容协议） ============
QWEN_API_KEY=sk-your-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max-2026-05-17

# 嵌入模型（稠密，2048 维）
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# 视觉/OCR 模型（简历扫描件识别）
QWEN_VL_OCR_MODEL=qwen-vl-max

# 评测裁判模型（LLM-as-Judge）：缺省回退到 QWEN_* 同一套凭据
# JUDGE_MODEL=
# JUDGE_API_KEY=
# JUDGE_BASE_URL=

# ============ 认证（JWT） ============
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
ALLOW_REGISTRATION=true

# 每用户每日 LLM token 预算（0 表示不限制）
DAILY_TOKEN_BUDGET=500000

# ============ MySQL（共享 rag-mysql 容器，端口 3306；按库名 interviewace_db 隔离） ============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=interviewace_db

# ============ Milvus（共享 rag-milvus 容器，端口 19530；按集合名 interview_kb 隔离） ============
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# 检索集合与稠密维度
RAG_COLLECTION=interview_kb
RAG_DIM=2048

# ============ 本地模型缓存（复用 SmartQuery 已下载的 bge-m3 / bge-reranker-v2-m3，无需重复下载） ============
HF_HOME=d:\项目\企业知识库智能问答系统\SmartQuery\model\.cache\huggingface
HF_ENDPOINT=https://hf-mirror.com
